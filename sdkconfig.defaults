CONFIG_IDF_TARGET="esp32"

# Flash 4MB (ESP32-WROOM-32E-N4, không PSRAM)
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Giữ nguyên bảng phân vùng OTA để có thể nạp bản này 1 lần qua Wi-Fi OTA
# (sau đó các lần nạp tiếp theo dùng UART) và giữ nguyên dữ liệu hiệu chuẩn NVS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS 1000 Hz (độ phân giải 1 ms)
CONFIG_FREERTOS_HZ=1000
